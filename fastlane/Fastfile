# =============================================================================
# Flutter Release Kit — shared Fastfile
# =============================================================================
#
# This file is NOT meant to be run directly. Each app imports it from its own
# tiny fastlane/Fastfile, and supplies its identifiers via fastlane/release_kit.yml.
#
#   fastlane android release   Build the AAB and upload it to Play Internal Testing
#   fastlane ios release       Build the IPA and upload it to TestFlight
#   fastlane upload_all        Both platforms in one run
#   fastlane verify            flutter analyze + flutter test
#   fastlane doctor            Validate this app's whole release setup
#
# Nothing here can publish to the public: Play uploads are pinned to a testing
# track and TestFlight runs with skip_submission. Promoting is a manual console
# step, by design.
#
# No credential value is ever written into this file, or into any app repo.
# Account-level credentials live in ~/.flutter-release/ (see docs/ONBOARDING.md).
# =============================================================================

require "shellwords"
require "json"
require "yaml"
require "date" # Date/Time are permitted_classes in the release_kit.yml loader below
require "fileutils"
require "pathname"
require "timeout" # store_versions caps each store probe; see the section at the end

fastlane_version "2.220.0"
opt_out_usage
skip_docs

# PROJECT_ROOT is the *app's* root, not the kit's: fastlane resolves its folder
# from the working directory, so an imported Fastfile still sees the app.
PROJECT_ROOT   = File.expand_path("..", FastlaneCore::FastlaneFolder.path.to_s)
FLUTTER_BIN    = ENV.fetch("FLUTTER_BIN", "flutter")
SYMBOLS_DIR    = "build/symbols".freeze
AAB_GLOB       = "build/app/outputs/bundle/release/*.aab".freeze
IPA_GLOB       = "build/ios/ipa/*.ipa".freeze
EXPORT_OPTIONS = "ios/ExportOptions.plist".freeze

# Where account-level credentials live, shared by every app. Overridable so a
# CI box or a second developer account can point somewhere else.
SHARED_CREDENTIALS_DIR = File.expand_path(
  ENV.fetch("FLUTTER_RELEASE_HOME", "~/.flutter-release")
).freeze

# -----------------------------------------------------------------------------
# Cross-platform lanes
# -----------------------------------------------------------------------------

# Named `verify` rather than `test` on purpose: a lane called `test` cannot be
# invoked from inside another lane, because Ruby's `Kernel#test` shadows it.
desc "Run the project's quality gate: flutter analyze + flutter test"
lane :verify do
  flutter("pub", "get")
  # Many trees carry info-level lints, and `flutter analyze` exits 1 on those
  # unless infos are explicitly non-fatal. Gate on real errors, so a release is
  # never blocked by a style hint.
  flutter("analyze", "--no-fatal-infos", "--no-fatal-warnings")
  flutter("test") if Dir.exist?(abs("test"))
end

desc "Validate this app's entire release setup without building anything"
lane :doctor do
  cfg = config
  UI.header("#{cfg['name']} — release setup")
  UI.message("Platforms      : #{platforms.join(', ')}")
  UI.message("pubspec version: #{pubspec_version}")
  UI.message("Kit            : #{KIT_ROOT}")
  UI.message("Credentials    : #{SHARED_CREDENTIALS_DIR}")

  problems = []

  if android?
    UI.header("Android")
    UI.message("package_name: #{android_package}")
    UI.message("track       : #{android_track}")
    begin
      preflight_android_signing
      UI.success("Signing: android/key.properties and keystore present")
    rescue StandardError => e
      problems << "Android signing: #{e.message.lines.first.to_s.strip}"
    end
    begin
      status = play_status(play_store_json_key)
      if status[:ok]
        UI.success("Play: edit access to #{android_package} confirmed")
        used = status[:uploaded_codes]
        UI.message("Highest versionCode uploaded: #{used.empty? ? 'none' : used.max}")
        UI.important("Next Android build must use build_number:#{used.max + 1} or higher") unless used.empty?
      elsif status[:missing]
        problems << "Play: #{status[:message].to_s.lines.first.to_s.strip} — " \
                    "create the listing in Play Console (the API cannot), or grant " \
                    "the service account access to it. See `fastlane android check_credentials`."
      else
        problems << "Play access to #{android_package}: #{status[:message].to_s.lines.first.to_s.strip}"
      end
    rescue StandardError => e
      problems << "Play credentials: #{e.message.lines.first.to_s.strip}"
    end
  end

  if ios?
    UI.header("iOS")
    UI.message("bundle_id: #{ios_bundle_id}")
    UI.message("team_id  : #{ios_team_id}")
    unless File.file?(abs(EXPORT_OPTIONS))
      problems << "#{EXPORT_OPTIONS} missing — run `frk onboard` to generate it"
    end
    begin
      preflight_ios_signing
      UI.success("Signing: Apple Distribution identity present in the keychain")
    rescue StandardError => e
      problems << "iOS signing: #{e.message.lines.first.to_s.strip}"
    end
    begin
      builds = testflight_builds(asc_api_key, limit: 5)
      UI.success("App Store Connect: #{ios_bundle_id} reachable")
      if builds.empty?
        UI.message("TestFlight: no builds yet")
      else
        b = builds.first
        UI.message("Latest TestFlight build: #{b.app_version} (#{b.version}) #{b.processing_state}")
      end
    rescue StandardError => e
      problems << "App Store Connect: #{e.message.lines.first.to_s.strip}"
    end
  end

  if problems.empty?
    UI.success("\nAll checks passed — this app is ready to release.")
  else
    UI.error("\n#{problems.count} problem(s) found:")
    problems.each { |p| UI.error("  - #{p}") }
    UI.user_error!("Release setup is incomplete. See docs/ONBOARDING.md.")
  end
end

# NOTE: despite the name, this does NOT publish to the public. It uploads to
# testers on whichever platforms this app supports.
desc "Upload release builds of every configured platform to testers"
desc "Android -> Play testing track, iOS -> TestFlight. Never production."
desc "Options: skip_android:true skip_ios:true skip_tests:true dry_run:true"
lane :upload_all do |options|
  verify unless truthy?(options[:skip_tests])

  # Tests already ran once above; don't repeat them per platform.
  child = options.merge(skip_tests: true)
  done = []

  if android? && !truthy?(options[:skip_android])
    runner.execute(:upload_internal, :android, child)
    done << "Android"
  end
  if ios? && !truthy?(options[:skip_ios])
    runner.execute(:upload_testflight, :ios, child)
    done << "iOS"
  end

  UI.user_error!("Nothing to upload — check `platforms` in fastlane/release_kit.yml") if done.empty?
  UI.success("#{done.join(' + ')} uploaded to testers. Promote in the consoles to go live.")
end

desc "Alias for `upload_all` — note this uploads to TESTERS, not production"
lane :release do |options|
  upload_all(options)
end

desc "Report what Google Play and App Store Connect already hold (read-only)"
desc "Builds nothing, uploads nothing and changes nothing in either store."
desc "Prints one machine-readable JSON line marked <<<FRK:STORE_VERSIONS:1>>>."
desc "Options: timeout:60 (seconds allowed per store)"
lane :store_versions do |options|
  emit_store_versions_report(options)
end

# -----------------------------------------------------------------------------
# Android
# -----------------------------------------------------------------------------

platform :android do
  desc "Build a release App Bundle"
  desc "Options: build_name:1.5.7 build_number:57"
  lane :build_aab do |options|
    require_platform!(:android)

    args = ["build", "appbundle", "--release"]
    args += ["--obfuscate", "--split-debug-info=#{SYMBOLS_DIR}"] if obfuscate?
    args.concat(extra_build_args("android"))
    args.concat(version_args(options, "ANDROID"))

    preflight_android_signing
    flutter("pub", "get")
    flutter(args)

    aab = newest(AAB_GLOB) or UI.user_error!("Build reported success but no .aab was found at #{AAB_GLOB}")
    UI.success("App Bundle: #{aab}")
    upload_crashlytics_symbols if truthy?(ENV["UPLOAD_CRASHLYTICS_SYMBOLS"]) && obfuscate?
    aab
  end

  desc "Build a release AAB and upload it to a Google Play TESTING track"
  desc "Builds a full production-grade bundle (release, release-signed)."
  desc "Only the destination is testers — this never touches the production track."
  desc "Options: build_name: build_number: dry_run:true skip_build:true skip_tests:true"
  private_lane :upload_internal do |options|
    require_platform!(:android)
    reject_version_override_with_skip_build!(options, "ANDROID")

    # Resolve credentials and check the version code up front: both can fail,
    # and neither is worth discovering after a multi-minute release build.
    json_key = play_store_json_key
    # Without rebuilding we cannot reliably infer an AAB's versionCode from
    # pubspec.yaml. Let Play validate the selected artifact instead of blocking
    # a valid bundle because the source version later changed.
    warn_if_version_code_not_higher(options, json_key) unless truthy?(options[:skip_build])

    verify unless truthy?(options[:skip_tests])

    aab = truthy?(options[:skip_build]) ? newest(AAB_GLOB) : build_aab(options)
    UI.user_error!("No .aab to upload — run `fastlane android build_aab` first") if aab.nil?

    dry_run = truthy?(options[:dry_run])
    UI.important("DRY RUN — Play will validate the bundle and discard it") if dry_run

    # Guard against a misconfigured track ever reaching the public.
    track = android_track
    UI.user_error!("Refusing to upload: track '#{track}' is not a testing track") if track == "production"

    upload_to_play_store(
      package_name: android_package,
      json_key: json_key,
      aab: aab,
      track: track,
      release_status: "completed",
      validate_only: dry_run,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )

    UI.success(dry_run ? "Play validation passed" : "Uploaded to Play (#{track} track)")
  end

  desc "Build a release AAB and upload it to the Play testing track"
  desc "Options: build_name: build_number: dry_run:true skip_build:true skip_tests:true"
  lane :release do |options|
    upload_internal(options)
  end

  desc "Alias for `release`, naming the destination track explicitly"
  lane :internal do |options|
    upload_internal(options)
  end

  desc "Alias for `release` — the conventional Fastlane lane name"
  lane :beta do |options|
    upload_internal(options)
  end

  desc "Upload the last built AAB to Play without publishing it (validation only)"
  lane :validate do |options|
    upload_internal(options.merge(dry_run: true, skip_build: true, skip_tests: true))
  end

  desc "Check that the Google Play service account can reach this app"
  lane :check_credentials do
    require_platform!(:android)
    key = play_store_json_key
    validate_play_store_json_key(json_key: key)
    UI.success("Authenticated with Google Play: #{key}")

    # Authenticating only proves the key is valid. Opening an edit on the app is
    # what proves the service account was actually granted access to *this* app.
    status = play_status(key)

    if !status[:ok] && status[:denied]
      UI.user_error!(<<~MSG)
        The service account authenticates, but Google Play denied access to
        #{android_package}:

          #{status[:message]}

        Grant it access:
          Play Console > Users and permissions > Invite new user (or edit the
          existing service-account user)
            email:  #{service_account_email(key)}
            App permissions: add #{android_package}
            Permissions: "Release to testing tracks, excluding production"
          then Invite user / Apply.

        Play grants are PER APP — a key that works for one of your apps says
        nothing about another. Also confirm the Google Play Android Developer API
        is enabled for the key's Google Cloud project.
      MSG
    elsif !status[:ok] && status[:missing]
      UI.user_error!(<<~MSG)
        Google Play has no app with the package name #{android_package}:

          #{status[:message]}

        The Publishing API cannot create an app — it only ever updates one that
        already exists. Create the listing first:

          Play Console > Create app > set the package name to
          #{android_package} when you upload the first bundle.

        Play returns this same 404 when the app exists but the service account
        was never granted access to it, so if you are sure the listing is there,
        grant access instead:
          Play Console > Users and permissions > App permissions
            email: #{service_account_email(key)}

        A brand-new listing may also require its very first bundle to go through
        the Console by hand; every release after that can use this lane.
      MSG
    elsif !status[:ok]
      UI.user_error!("Reached Google Play but the request failed: #{status[:message]}")
    end

    UI.success("Edit access to #{android_package} confirmed — uploads will work.")
    UI.message("Track '#{android_track}' version codes: #{status[:internal_codes].empty? ? 'none (track is empty)' : status[:internal_codes].join(', ')}")
    used = status[:uploaded_codes]
    UI.message("Highest version code ever uploaded: #{used.empty? ? 'none' : used.max}")
    UI.important("Next Android build must use build_number:#{used.max + 1} or higher") unless used.empty?
  end
end

# -----------------------------------------------------------------------------
# iOS
# -----------------------------------------------------------------------------

platform :ios do
  desc "Build a signed release IPA"
  desc "Options: build_name:1.2.0 build_number:8"
  lane :build_ipa do |options|
    require_platform!(:ios)
    ensure_export_options!
    preflight_ios_signing

    args = ["build", "ipa", "--release", "--export-options-plist=#{EXPORT_OPTIONS}"]
    args.concat(extra_build_args("ios"))
    args.concat(version_args(options, "IOS"))

    flutter("pub", "get")
    flutter(args)

    ipa = newest(IPA_GLOB) or UI.user_error!(
      "Build reported success but no .ipa was found at #{IPA_GLOB}. " \
      "Check that #{EXPORT_OPTIONS} has <key>destination</key><string>export</string>."
    )
    UI.success("IPA: #{ipa}")
    ipa
  end

  desc "Build a release IPA and upload it to TESTFLIGHT"
  desc "Builds a full production-grade IPA (release, release-signed) — the very"
  desc "same binary Apple reviews. Only the destination is testers; this never"
  desc "submits for App Store review."
  desc "Options: build_name: build_number: skip_build:true skip_tests:true"
  private_lane :upload_testflight do |options|
    require_platform!(:ios)
    reject_version_override_with_skip_build!(options, "IOS")

    # Credentials and build number first: both can fail, and neither is worth
    # discovering after an archive. For upload-only, trust the IPA's embedded
    # version rather than today's pubspec.yaml.
    api_key = asc_api_key
    existing_ipa = truthy?(options[:skip_build]) ? newest(IPA_GLOB) : nil
    UI.user_error!("No .ipa to upload — run `fastlane ios build_ipa` first") if truthy?(options[:skip_build]) && existing_ipa.nil?
    check_options = options
    if existing_ipa && (embedded = ipa_version(existing_ipa))
      check_options = options.merge(build_name: embedded[0], build_number: embedded[1])
    end
    warn_if_testflight_build_taken(check_options, api_key)

    verify unless truthy?(options[:skip_tests])

    ipa = truthy?(options[:skip_build]) ? existing_ipa : build_ipa(options)
    UI.user_error!("No .ipa to upload — run `fastlane ios build_ipa` first") if ipa.nil?

    # Trust the artifact, not the request. Xcode can rewrite CFBundleVersion
    # during export, so this is the only version that means anything downstream.
    actual_name, actual_number = ipa_version(ipa) || ios_version(options)
    requested_name, requested_number = ios_version(options)
    if actual_number != requested_number || actual_name != requested_name
      UI.important("Xcode shipped #{actual_name} (#{actual_number}), not the requested " \
                   "#{requested_name} (#{requested_number}) — using the artifact's version")
    end
    UI.message("Uploading #{File.basename(ipa)} — version #{actual_name}, build #{actual_number}")

    changelog = ENV["TESTFLIGHT_CHANGELOG"].to_s.strip
    wait = !changelog.empty? # `changelog` is only applied once processing finishes

    # Apple's default Transporter path has repeatedly stalled: 88 MB uploads
    # that complete in ~100s over DAV ran 45-80 minutes without finishing on the
    # default transport. DAV is Apple's plain-HTTP transport and is the
    # documented fallback for slow or lossy links.
    #   Escape hatch: TESTFLIGHT_TRANSPORT=default (or any other -t value)
    transport = ENV.fetch("TESTFLIGHT_TRANSPORT", "DAV")
    unless transport == "default"
      ENV["DELIVER_ITMSTRANSPORTER_ADDITIONAL_UPLOAD_PARAMETERS"] = "-t #{transport}"
      UI.message("Transporter mode: -t #{transport}")
    end

    upload_to_testflight_with_retry(
      api_key: api_key,
      ipa: ipa,
      version: actual_name,
      number: actual_number,
      wait: wait,
      changelog: changelog
    )
  end

  desc "Build a release IPA and upload it to TESTFLIGHT"
  desc "Options: build_name: build_number: skip_build:true skip_tests:true"
  lane :release do |options|
    upload_testflight(options)
  end

  desc "Alias for `release` — the conventional Fastlane lane name"
  lane :beta do |options|
    upload_testflight(options)
  end

  desc "Upload the last built IPA to TestFlight without rebuilding"
  lane :upload_only do |options|
    upload_testflight(options.merge(skip_build: true, skip_tests: true))
  end

  desc "Run App Store Connect's static validation on the last built IPA"
  lane :validate do
    require_platform!(:ios)
    ipa = newest(IPA_GLOB) or UI.user_error!("No .ipa found — run `fastlane ios build_ipa` first")
    key = asc_key_parts
    UI.user_error!("`ios validate` needs ASC_KEY_FILEPATH (a .p8 on disk), not ASC_KEY_CONTENT") if key[:filepath].empty?

    # `altool --validate-app` is what App Store Connect runs before accepting a
    # build. altool only looks for the .p8 in a handful of fixed directories,
    # so point it at wherever ours actually lives.
    sh({ "API_PRIVATE_KEYS_DIR" => File.dirname(key[:filepath]) },
       "xcrun altool --validate-app -f #{ipa.shellescape} -t ios " \
       "--apiKey #{key[:key_id].shellescape} --apiIssuer #{key[:issuer_id].shellescape}")
    UI.success("IPA passed App Store Connect validation")
  end

  desc "Check that the App Store Connect API key works for this app"
  lane :check_credentials do
    require_platform!(:ios)
    api_key = asc_api_key
    # Loading the key proves nothing — a wrong issuer id loads fine. Make a real
    # API call so the key id, issuer id and .p8 are all verified together.
    builds = testflight_builds(api_key, limit: 5)
    UI.success("App Store Connect reachable with key #{asc_key_parts[:key_id]}")
    if builds.empty?
      UI.message("TestFlight: no builds for #{ios_bundle_id} yet")
    else
      b = builds.first
      UI.message("Latest TestFlight build: #{b.app_version} (#{b.version}) #{b.processing_state}")
      UI.important("Next iOS build for #{b.app_version} must use build_number:#{b.version.to_i + 1} or higher")
    end
  end

  desc "Create (or reuse) the Apple Distribution certificate and App Store profile"
  desc "Driven entirely by the App Store Connect API key — no Xcode account session needed."
  lane :setup_signing do
    require_platform!(:ios)
    api_key = asc_api_key

    # The certificate is ACCOUNT-level and shared by every app on the team, so
    # this normally reuses an existing one. Apple caps distribution certificates
    # and never re-issues a private key — back up the .p12 this writes.
    cert(
      api_key: api_key,
      development: false,
      team_id: ios_team_id,
      output_path: signing_output_dir
    )

    # The provisioning profile IS per app. `sigh` installs it into Xcode's own
    # provisioning profile cache as a side effect (its default `skip_install`
    # is false), which is what makes the next step able to find it by name.
    sigh(
      api_key: api_key,
      app_identifier: ios_bundle_id,
      team_id: ios_team_id,
      platform: "ios",
      provisioning_name: ios_profile_name,
      filename: ios_profile_filename,
      output_path: signing_output_dir
    )

    # `cert`/`sigh` only reach Apple's servers and the local Keychain/profile
    # cache. Xcode's own project still defaults to "Automatically manage
    # signing", which resolves to whatever identity Xcode picks for the
    # current run destination — usually a development certificate — and an
    # archive build signs with THAT, independent of ExportOptions.plist's
    # `signingStyle: manual` (that governs re-export only, after the archive
    # already exists). Pin Release to the profile `sigh` just installed so
    # archiving and exporting agree, instead of leaving a user to discover the
    # mismatch by hand in Xcode. Debug and Profile are left untouched: this
    # tool never builds either for release, and a developer still needs an
    # ordinary development identity to run and profile on a device.
    update_code_signing_settings(
      path: abs("ios/Runner.xcodeproj"),
      use_automatic_signing: false,
      team_id: ios_team_id,
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: ios_profile_name,
      bundle_identifier: ios_bundle_id
    )

    UI.success("Certificate: #{Actions.lane_context[SharedValues::CERT_CERTIFICATE_ID]}")
    UI.success("Profile: #{Actions.lane_context[SharedValues::SIGH_NAME]}")
    UI.success("Xcode's Release configuration now signs manually with this profile")
    UI.important("Back up #{signing_output_dir}/*.p12 — Apple never re-issues a private key")
  end

  desc "List recent TestFlight builds with their processing state"
  desc "`latest_testflight_build_number` only reports builds that finished processing,"
  desc "so right after an upload it looks like nothing arrived. This shows the truth."
  lane :builds do
    require_platform!(:ios)
    recent = testflight_builds(asc_api_key, limit: 10)

    if recent.empty?
      UI.important("No builds found for #{ios_bundle_id}")
    else
      UI.message("Recent builds for #{ios_bundle_id}:")
      recent.each do |b|
        UI.message(format("  %-10s build %-5s %-12s %s",
                          b.app_version, b.version, b.processing_state, b.uploaded_date))
      end
    end
    recent
  end

  desc "Report what signing material exists locally and in the Apple Developer account"
  lane :check_signing do
    require_platform!(:ios)
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)

    local = sh("security find-identity -v -p codesigning || true", log: false)
    local_names = local.scan(/"([^"]+)"/).flatten
    UI.message("Local codesigning identities:")
    local_names.each { |n| UI.message("  - #{n}") }
    UI.message("  (none)") if local_names.empty?

    certs = Spaceship::ConnectAPI::Certificate.all
    UI.message("Certificates in the Apple Developer account:")
    certs.each do |c|
      UI.message("  - #{c.certificate_type}  #{c.display_name.inspect}  expires #{c.expiration_date}")
    end
    UI.message("  (none)") if certs.empty?

    dist_local = local_names.any? { |n| n.match?(/Apple Distribution|iPhone Distribution/) }
    dist_remote = certs.any? { |c| c.certificate_type.to_s.match?(/DISTRIBUTION/) }

    if dist_local
      UI.success("A distribution identity is present locally — `fastlane ios release` can archive.")
    elsif dist_remote
      UI.important(<<~MSG)
        The account HAS a distribution certificate, but its private key is not in
        this Mac's keychain — and Apple never re-issues a private key. Either
        import the original .p12, or create a fresh certificate with
        `fastlane ios setup_signing` (Apple caps these, so revoke an unused one
        first if you are at the limit).
      MSG
    else
      UI.important("No distribution certificate exists locally or in the account. Run `fastlane ios setup_signing`.")
    end
  end

  desc "Upload the archive's dSYMs to Crashlytics (for symbolicated iOS crash reports)"
  lane :upload_dsyms do
    require_platform!(:ios)
    archive = newest("build/ios/archive/*.xcarchive") or
      UI.user_error!("No .xcarchive found — run `fastlane ios build_ipa` first")

    gsp = abs("ios/Runner/GoogleService-Info.plist")
    UI.user_error!("No GoogleService-Info.plist — this app has no Firebase iOS config") unless File.file?(gsp)

    upload_symbols_to_crashlytics(dsym_path: File.join(archive, "dSYMs"), gsp_path: gsp)
  end
end

# =============================================================================
# Per-app configuration
# =============================================================================
#
# Everything app-specific comes from <app>/fastlane/release_kit.yml. Keeping it
# in data rather than in code is what lets ~10 apps share one Fastfile: fixing a
# bug here fixes it everywhere, with no per-app edits.

# __dir__ is the kit's fastlane/ directory, so the kit root is one level up.
KIT_ROOT = File.expand_path("..", __dir__).freeze
CONFIG_PATH = "fastlane/release_kit.yml".freeze

def config
  @config ||= begin
    path = abs(CONFIG_PATH)
    UI.user_error!(<<~MSG) unless File.file?(path)
      #{CONFIG_PATH} not found in #{PROJECT_ROOT}.

      This app has not been onboarded to the Flutter Release Kit. Run:
        #{KIT_ROOT}/bin/frk onboard #{PROJECT_ROOT}
    MSG

    # safe_load rather than load_file, with the permitted set and `aliases:`
    # spelled out. load_file behaves differently on either side of Psych 4: on
    # Psych 3 (system Ruby 2.6) it is an unrestricted load that accepts anchors,
    # on Psych 4+ it is a safe load that rejects them with AliasesNotEnabled.
    # Anchors are how an app shares settings between its android and ios blocks,
    # so they stay allowed — and Symbol stays permitted because Psych 5 permits
    # it by default and dropping it would narrow the configs this kit accepts.
    loaded = begin
      YAML.safe_load(File.read(path), permitted_classes: [Symbol, Date, Time], aliases: true, filename: path) || {}
    rescue Psych::SyntaxError => e
      # A typo in release_kit.yml is the likeliest failure of all; without this
      # it surfaces as a fastlane crash report with a raw Ruby backtrace.
      UI.user_error!("#{CONFIG_PATH} is not valid YAML: #{e.message}")
    end
    UI.user_error!("#{CONFIG_PATH} is not a YAML mapping") unless loaded.is_a?(Hash)
    loaded["name"] ||= File.basename(PROJECT_ROOT)
    loaded
  end
end

def platforms
  @platforms ||= begin
    list = Array(config["platforms"]).map { |p| p.to_s.strip.downcase }.reject(&:empty?)
    UI.user_error!("#{CONFIG_PATH}: `platforms` must list at least one of android, ios") if list.empty?
    unknown = list - %w[android ios]
    UI.user_error!("#{CONFIG_PATH}: unknown platform(s) #{unknown.join(', ')}") unless unknown.empty?
    list
  end
end

# Conventional `def ... end` throughout: endless method definitions are Ruby
# 3.0+, and keeping to older syntax means the kit runs on any Ruby fastlane
# itself supports.
def android?
  platforms.include?("android")
end

def ios?
  platforms.include?("ios")
end

# Fail with an explanation rather than a confusing credential error when a lane
# is run for a platform this app does not ship.
def require_platform!(platform)
  return if platforms.include?(platform.to_s)

  UI.user_error!(
    "#{config['name']} is not configured for #{platform}. " \
    "Its platforms are: #{platforms.join(', ')}. " \
    "If that is wrong, edit `platforms` in #{CONFIG_PATH}."
  )
end

def platform_config(platform)
  (config[platform.to_s] || {}).tap do |h|
    UI.user_error!("#{CONFIG_PATH}: `#{platform}:` section is missing") if h.empty?
  end
end

def required_setting(platform, key)
  value = platform_config(platform)[key].to_s.strip
  UI.user_error!("#{CONFIG_PATH}: `#{platform}.#{key}` is required") if value.empty?
  value
end

def android_package
  required_setting(:android, "package_name")
end

def ios_bundle_id
  required_setting(:ios, "bundle_id")
end

def ios_team_id
  required_setting(:ios, "team_id")
end

# Testing tracks only. `production` is rejected at upload time as well.
def android_track
  track = (platform_config(:android)["track"] || "internal").to_s.strip
  allowed = %w[internal alpha beta]
  UI.user_error!("#{CONFIG_PATH}: android.track must be one of #{allowed.join(', ')} (got '#{track}')") unless allowed.include?(track)
  track
end

# Coerced explicitly rather than by Ruby truthiness. A bare Ruby `? :` gets this
# wrong in both directions: a blank `obfuscate:` line is nil, which is falsey, so
# `fetch`'s default never applied and the release shipped unobfuscated; while
# `0`, `"no"` and `""` are all truthy in Ruby, so values that read as "off"
# turned obfuscation on. The vocabulary is `boolean_word`'s, shared with
# `truthy?`, so both halves stay mirror images of each other.
#
# nil, "" and "   " all mean "no intent expressed" -- the same situation as
# omitting the key -- and take the documented default. A value that IS a stated
# intent but is not interpretable (a typo) stops the run, because guessing either
# way ships the wrong artifact and guessing "on" would ship an unobfuscated
# release under a config that asked for one.
def obfuscate?
  value = config.fetch("obfuscate", true)
  return true if value.nil?
  return value if value == true || value == false
  return true if value.to_s.strip.empty?

  decided = boolean_word(value)
  return decided unless decided.nil?

  UI.user_error!("#{CONFIG_PATH}: obfuscate must be true or false (got #{value.inspect})")
end

# Appended to every `flutter build` invocation, after every flag this tool
# already sets and before the version flags, so `--build-name`/`--build-number`
# always win if a value here ever collided with them. Exists for `--dart-define`
# and other project-specific flags this tool has no opinion about; empty by
# default, so every existing app keeps building exactly as it does today.
#
# Two sources, concatenated: the top-level list (applies to every platform the
# app ships) and that platform's own list under `android:`/`ios:` (applies to
# it alone) -- a flag needed on Android but not iOS belongs only in the
# second. Each is validated on its own, so a mistake in one names itself
# rather than the other.
#
# Both must be real YAML lists, never one string with several flags run
# together: `flutter(*args)` shell-escapes each ARRAY ELEMENT as its own
# token, so "--dart-define=A=1 --dart-define=B=2" as a single string would
# arrive as one unsplittable argument instead of two flags, rather than being
# silently space-split (which would reopen the injection risk that
# array-based escaping exists to close).
def extra_build_args_list(raw, label)
  return [] if raw.nil?
  unless raw.is_a?(Array) && raw.all? { |v| v.is_a?(String) }
    UI.user_error!(
      "#{CONFIG_PATH}: #{label} must be a list of strings, e.g.\n" \
      "  #{label.split('.').last}:\n" \
      "    - \"--dart-define=KEY=value\"\n" \
      "(got #{raw.inspect})"
    )
  end
  raw
end

def extra_build_args(platform)
  # Reads the section directly rather than through `platform_config`, which
  # raises if `android:`/`ios:` is absent or empty -- a check that belongs to
  # REQUIRED settings like package_name, not to this optional one. A project
  # with no platform-specific extra args yet is not a configuration error.
  platform_section = config[platform.to_s] || {}
  extra_build_args_list(config["extra_build_args"], "extra_build_args") +
    extra_build_args_list(platform_section["extra_build_args"], "#{platform}.extra_build_args")
end

# How long one TestFlight upload attempt may run before it is cancelled and
# retried. Default 8 minutes: observed healthy uploads typically finish in
# 100-200 seconds, while stalls run 45+ minutes, so 8 is several times the normal
# case yet still catches a hang quickly.
def ios_upload_timeout_minutes
  value = ENV["IOS_UPLOAD_TIMEOUT_MINUTES"] || platform_config(:ios)["upload_timeout_minutes"] || 8
  minutes = value.to_i
  UI.user_error!("upload_timeout_minutes must be a positive integer (got #{value})") if minutes < 1
  minutes
end

# Total attempts, including the first. Default 3 — stalls are random and normally
# clear on the second or third try.
def ios_upload_attempts
  value = ENV["IOS_UPLOAD_ATTEMPTS"] || platform_config(:ios)["upload_attempts"] || 3
  attempts = value.to_i
  UI.user_error!("upload_attempts must be a positive integer (got #{value})") if attempts < 1
  attempts
end

def firebase_android_app_id
  (platform_config(:android)["firebase_app_id"] || "").to_s.strip
end

# Where setup_signing writes certificates/profiles. Signing material belongs in
# the private machine vault, not in any app repository. The distribution
# certificate is team-level; provisioning profiles inside this folder remain
# app-specific by filename.
def signing_output_dir
  dir = File.join(SHARED_CREDENTIALS_DIR, "signing", "ios", ios_team_id)
  FileUtils.mkdir_p(dir)
  File.chmod(0o700, dir)
  dir
end

def ios_profile_name
  "#{ios_bundle_id} AppStore"
end

def ios_profile_filename
  "AppStore_#{ios_bundle_id}.mobileprovision"
end

def ios_profile_path
  File.join(signing_output_dir, ios_profile_filename)
end

# =============================================================================
# Helpers
# =============================================================================

# The one boolean vocabulary in this file: true / false / nil for "not a boolean
# word at all". The two halves are deliberate mirror images covering the YAML 1.1
# spellings a user could reasonably quote -- Psych resolves the BARE forms
# (`on`, `off`, `yes`, `no`) to real booleans itself, so only the quoted ones
# ever reach here, and an incomplete half turns a working config into an error.
# Callers decide what nil means: `truthy?` reads it as false, `obfuscate?` stops.
def boolean_word(value)
  word = value.to_s.strip.downcase
  return true if %w[true yes y on 1].include?(word)
  return false if %w[false no n off 0].include?(word)

  nil
end

# Opt-in flags: anything that is not a recognised "on" word means "do the work".
def truthy?(value)
  boolean_word(value) == true
end

def abs(relative)
  File.expand_path(relative, PROJECT_ROOT)
end

# Newest file matching an app-relative glob, or nil.
def newest(glob)
  Dir.glob(File.join(PROJECT_ROOT, glob)).max_by { |f| File.mtime(f) }
end

def flutter(*args) # Escapes only the arguments that need it. `shelljoin` would render every `--flag=value` as `--flag\=value`, and this `sh` has no `log: false`, so fastlane echoes the string three times per build -- backslashes there would change `frk build` stdout. The pass-through set is Shellwords' own minus newline, plus `=` for the `--flag=value` form; nothing in it can quote, expand, glob, redirect or separate, so a pass-through cannot widen argv. Anything else, empty string included, is shellescaped exactly once. Per-character rationale and both halves of that property: tests/ruby/test_release_kit.rb, "--- flutter ---".
  sh("cd #{PROJECT_ROOT.shellescape} && #{FLUTTER_BIN.shellescape} #{args.flatten.map { |a| a = a.to_s; a.match?(%r{\A[A-Za-z0-9\-_./=+:@,]+\z}) ? a : a.shellescape }.join(' ')}")
end

# --build-name / --build-number, from lane options then env. Unset means "use
# the version in pubspec.yaml". Nothing is auto-incremented because an app may
# keep separate version streams per store, so guessing would be wrong.
def version_args(options, env_prefix)
  name   = options[:build_name]   || ENV["#{env_prefix}_BUILD_NAME"]
  number = options[:build_number] || ENV["#{env_prefix}_BUILD_NUMBER"]

  fallback_name, fallback_number = pubspec_version_parts
  effective_name = name.to_s.strip.empty? ? fallback_name : name.to_s.strip
  effective_number = number.to_s.strip.empty? ? fallback_number : number.to_s.strip
  UI.user_error!("Build name cannot be empty or contain whitespace") if effective_name.empty? || effective_name.match?(/\s/)
  # Reachable only when nothing was overridden, since a supplied number is never
  # empty here. The generic integer complaint below would say "(got '')" without
  # ever naming the file the user has to edit.
  if effective_number.empty?
    UI.user_error!(
      "pubspec.yaml has no build number — `version: #{fallback_name}` needs a `+<number>` " \
      "suffix (for example `#{fallback_name}+1`). Add one, or pass build_number:<n>."
    )
  end
  unless effective_number.match?(/\A[1-9]\d*\z/) && effective_number.to_i <= 2_100_000_000
    UI.user_error!("Build number must be an integer between 1 and 2100000000 (got '#{effective_number}')")
  end

  args = []
  args << "--build-name=#{name.to_s.strip}" unless name.to_s.strip.empty?
  args << "--build-number=#{number.to_s.strip}" unless number.to_s.strip.empty?

  if args.empty?
    UI.message("Version: pubspec.yaml (#{pubspec_version})")
  else
    UI.message("Version override: #{args.join(' ')}")
  end
  args
end

def reject_version_override_with_skip_build!(options, env_prefix)
  return unless truthy?(options[:skip_build])

  overridden = options[:build_name] || options[:build_number] ||
               ENV["#{env_prefix}_BUILD_NAME"] || ENV["#{env_prefix}_BUILD_NUMBER"]
  return if overridden.to_s.strip.empty?

  UI.user_error!(
    "Do not combine skip_build:true with version overrides; the existing " \
    "artifact may contain a different version."
  )
end

def pubspec_version
  path = abs("pubspec.yaml")
  UI.user_error!("pubspec.yaml not found in #{PROJECT_ROOT} — this is not a Flutter project") unless File.file?(path)
  File.read(path)[/^version:\s*(\S+)/, 1].to_s
end

# The `<name>+<number>` halves of the pubspec version, parsed once. Four call
# sites used to split this string four different ways, and the two that took
# `.split("+").last` read the whole version as the build number whenever the
# `+N` suffix was missing — which silently disabled both duplicate-version
# guards. Deliberately never raises: a pubspec with no `version:` still builds
# when both overrides are supplied, and every caller reaches this only after
# `||` has failed to find an override. Refusing here would break that.
def pubspec_version_parts
  @pubspec_version_parts ||= begin
    name, number = pubspec_version.split("+", 2)
    [name.to_s.strip, number.to_s.strip]
  end
end

# --- shared credentials -------------------------------------------------------

# Account-level credentials are shared by every app, so they live once in
# ~/.flutter-release/credentials.env rather than being copied into each repo.
# An app's own fastlane/.env (already loaded by fastlane's dotenv) wins, so a
# single app can point at a different developer account.
def load_shared_credentials!
  return if @shared_credentials_loaded

  @shared_credentials_loaded = true
  path = File.join(SHARED_CREDENTIALS_DIR, "credentials.env")
  unless File.file?(path)
    UI.verbose("no shared credentials at #{path}")
    return
  end

  File.readlines(path).each do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, _, value = line.partition("=")
    key = key.strip
    value = value.strip.gsub(/\A["']|["']\z/, "")
    next if key.empty?

    # Never clobber something the app or the shell already set.
    ENV[key] = value unless ENV.key?(key) && !ENV[key].to_s.strip.empty?
  end
  UI.verbose("loaded shared credentials from #{path}")
end

# Resolve a credential path that may be relative to the app, to the shared
# credentials dir, or absolute.
def resolve_credential_path(value)
  return nil if value.to_s.strip.empty?

  raw = File.expand_path(value.to_s.strip)
  return raw if File.file?(raw)

  [PROJECT_ROOT, SHARED_CREDENTIALS_DIR].each do |base|
    candidate = File.expand_path(value.to_s.strip, base)
    return candidate if File.file?(candidate)
  end
  nil
end

# --- Android credentials ------------------------------------------------------

def play_store_json_key
  load_shared_credentials!

  # An app may name its own key (different developer account); otherwise the
  # shared default is used.
  configured = platform_config(:android)["play_json_key"].to_s.strip
  configured = ENV["SUPPLY_JSON_KEY"].to_s.strip if configured.empty?

  unless configured.empty?
    path = resolve_credential_path(configured)
    UI.user_error!(<<~MSG) if path.nil?
      Google Play service account key not found: #{configured}

      Looked in the app root (#{PROJECT_ROOT}) and #{SHARED_CREDENTIALS_DIR}.
    MSG
    return path
  end

  found = Dir.glob([
    File.join(SHARED_CREDENTIALS_DIR, "play", "*.json"),
    File.join(PROJECT_ROOT, "key", "*.json")
  ]).select do |f|
    begin
      JSON.parse(File.read(f))["type"] == "service_account"
    rescue StandardError
      false
    end
  end
  return found.first if found.one?
  if found.length > 1
    UI.user_error!(<<~MSG)
      More than one Google Play service-account key was found:
        #{found.join("\n  ")}

      Select one explicitly with SUPPLY_JSON_KEY in
      #{File.join(SHARED_CREDENTIALS_DIR, 'credentials.env')}, or set
      android.play_json_key for this app in #{CONFIG_PATH}.
    MSG
  end

  UI.user_error!(<<~MSG)
    No Google Play service account key found.

    Put the JSON key in #{File.join(SHARED_CREDENTIALS_DIR, 'play')} and set
    SUPPLY_JSON_KEY in #{File.join(SHARED_CREDENTIALS_DIR, 'credentials.env')}.

    Create one at Google Cloud Console > IAM & Admin > Service Accounts > Keys,
    enable the Google Play Android Developer API for that project, then grant it
    access to #{android_package} in Play Console > Users and permissions.
  MSG
end

# Ask Play what it already knows about this app.
#
# Deliberately not fastlane's `google_play_track_version_codes`: that calls
# `result.releases.flat_map(...)`, and a track that exists but holds no releases
# comes back as HTTP 200 with `releases` nil, so the action dies with
# `undefined method 'flat_map' for nil` — indistinguishable, from the outside,
# from a real permissions failure (supply/lib/supply/client.rb:501; its rescue
# only covers the 404 "track not found" case).
#
# Returns { ok: true, internal_codes: [...], uploaded_codes: [...], tracks: [...] }
#      or { ok: false, denied: bool, message: String } for anything Play refuses
# or the network eats. A user error raised while resolving this app's own config
# still propagates — that is a setup mistake, not a Play answer.
#
# `include_tracks:` adds one more read (`list_edit_tracks`) inside the same edit,
# because version codes are PER TRACK and the configured track alone does not say
# what the rest of the app already holds. It is opt-in and defaults to off so the
# release path keeps making exactly the calls it made before, and so a failure of
# that extra read can never downgrade the version-code guard: it is rescued
# locally to an empty list rather than turning the whole answer into ok: false.
def play_status(json_key, include_tracks: false)
  require "google/apis/androidpublisher_v3"
  require "googleauth"

  package = android_package
  track = android_track

  service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
  # Block form: make_creds reads the key and does not take ownership of the
  # handle, so the bare File.open left a descriptor open for the whole run.
  service.authorization = File.open(json_key) do |io|
    Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: io,
      scope: [Google::Apis::AndroidpublisherV3::AUTH_ANDROIDPUBLISHER]
    )
  end

  edit = service.insert_edit(package)
  begin
    on_track = service.get_edit_track(package, edit.id, track)
    bundles  = service.list_edit_bundles(package, edit.id)
    {
      ok: true,
      internal_codes: (on_track.releases || []).flat_map { |r| r.version_codes || [] }.map(&:to_i).sort,
      uploaded_codes: (bundles.bundles || []).map { |b| b.version_code.to_i }.sort,
      tracks: include_tracks ? play_track_summaries(service, package, edit.id) : []
    }
  ensure
    # Read-only probe: throw the edit away rather than leaving it open.
    begin
      service.delete_edit(package, edit.id)
    rescue StandardError => e
      UI.verbose("could not delete probe edit: #{e.message}")
    end
  end
rescue Google::Apis::ClientError => e
  {
    ok: false,
    denied: [401, 403].include?(e.status_code),
    # 404 means Play will not admit the package exists — either it was never
    # created in the Console, or this service account cannot see it. Google
    # answers both the same way on purpose, so the two are not separable here.
    missing: e.status_code == 404,
    status_code: e.status_code,
    message: play_error_message(e)
  }
rescue FastlaneCore::Interface::FastlaneError
  # `android_package` and `android_track` raise this for a bad release_kit.yml.
  # That is a setup mistake, not something Play said, and folding it into
  # `ok: false` made `warn_if_version_code_not_higher` downgrade it to
  # "skipping the version-code check" — so the run continued through a full
  # release build before the lane body finally rejected the track.
  raise
rescue StandardError => e
  { ok: false, denied: false, missing: false, status_code: nil, message: e.message }
end

# One entry per Play track that actually holds a release, as
# { "track" => "internal", "versionCode" => 38, "versionName" => "2.0.9" | nil }.
#
# Tracks with no releases are dropped rather than reported with a null code: an
# empty track says nothing, and an entry that exists but is blank reads like a
# failed read. Best-effort by design — a caller that already has the configured
# track's codes must not lose them because this extra read failed.
def play_track_summaries(service, package, edit_id)
  response = service.list_edit_tracks(package, edit_id)
  summaries = Array(response && response.tracks).map do |entry|
    releases = Array(entry.releases)
    codes = releases.flat_map { |r| Array(r.version_codes) }.map(&:to_i).reject { |c| c <= 0 }
    next nil if codes.empty?

    highest = codes.max
    newest = releases.max_by { |r| Array(r.version_codes).map(&:to_i).max || 0 }
    {
      "track" => entry.track.to_s,
      "versionCode" => highest,
      "versionName" => play_release_version_name(newest, highest)
    }
  end
  summaries.compact
rescue StandardError => e
  UI.verbose("could not list Play tracks: #{e.message}")
  []
end

# The Play Publishing API does not expose a versionName anywhere: neither a
# TrackRelease nor a Bundle carries one. The only place the string survives is
# the release's display `name`, which Play defaults to "<versionName> (<code>)".
#
# So this parses rather than reads, and refuses to guess: a name that is not
# recognisably a version returns nil, because a wrong version name in a
# duplicate-detection report is worse than an absent one.
def play_release_version_name(release, version_code)
  name = release.respond_to?(:name) ? release.name.to_s.strip : ""
  return nil if name.empty?

  match = name.match(/\A(.+?)\s*\(#{version_code}\)\z/)
  candidate = (match ? match[1] : name).strip
  return nil unless candidate.match?(/\A\d+(\.\d+)*([-+][0-9A-Za-z.\-]+)?\z/)

  candidate
end

# `Google::Apis::ClientError#message` is a generic label — every 4xx from the
# Publishing API reads "Invalid request". The sentence that identifies the
# actual problem ("Package not found: com.example.app") is only in the JSON
# body, so a caller shown just the message cannot tell a missing app from a
# permissions failure.
def play_error_message(error)
  detail = JSON.parse(error.body.to_s).dig("error", "message").to_s.strip
  detail.empty? ? error.message : detail
rescue StandardError
  error.message
end

# Play requires a version code to be unused app-wide, so an empty testing track
# proves nothing — check against every bundle ever uploaded. An app can keep an
# Android version stream well ahead of pubspec.yaml, which makes a
# silent duplicate very easy to produce.
def warn_if_version_code_not_higher(options, json_key)
  local = (options[:build_number] || ENV["ANDROID_BUILD_NUMBER"] || pubspec_version_parts[1]).to_s.strip
  return unless local.match?(/\A\d+\z/)

  status = play_status(json_key)
  unless status[:ok]
    UI.important("Could not read Play version codes — skipping the version-code check (#{status[:message].to_s.lines.first.to_s.strip})")
    return
  end

  used = status[:uploaded_codes]
  return if used.empty?

  highest = used.max
  return if local.to_i > highest

  conflict = used.include?(local.to_i) ? "is already uploaded" : "is not higher than #{highest}, already uploaded"
  UI.user_error!(<<~MSG)
    versionCode #{local} #{conflict}. Play will reject this bundle.

    Pass the next one explicitly, e.g.
      fastlane android release build_number:#{highest + 1}
    or set ANDROID_BUILD_NUMBER in fastlane/.env.
  MSG
end

def service_account_email(json_key)
  JSON.parse(File.read(json_key))["client_email"].to_s
rescue StandardError
  "<the client_email in the JSON key>"
end

def preflight_android_signing
  props = abs("android/key.properties")
  UI.user_error!(<<~MSG) unless File.file?(props)
    android/key.properties is missing — the release build would be signed with
    the debug key and Play would reject it. Create it with storePassword,
    keyPassword, keyAlias and storeFile pointing at this app's upload keystore.
  MSG

  content = File.read(props)
  required = %w[storeFile storePassword keyAlias keyPassword]
  missing = required.reject { |key| content[/^\s*#{Regexp.escape(key)}\s*=\s*(.+)$/, 1].to_s.strip.length.positive? }
  UI.user_error!("android/key.properties is incomplete: #{missing.join(', ')}") unless missing.empty?

  store = content[/^\s*storeFile\s*=\s*(.+)$/, 1].to_s.strip
  UI.user_error!("android/key.properties has no storeFile entry") if store.empty?

  store_path = if Pathname.new(store).absolute?
                 File.expand_path(store)
               else
                 # Gradle's file(...) resolves from android/app, while the less
                 # common rootProject.file(...) resolves from android/. Match
                 # the app's build script so preflight and Gradle inspect the
                 # same file.
                 gradle = [abs("android/app/build.gradle.kts"), abs("android/app/build.gradle")]
                          .select { |path| File.file?(path) }
                          .map { |path| File.read(path) }
                          .join("\n")
                 base = gradle.match?(/storeFile[^\n]{0,200}rootProject\.file/) ? abs("android") : abs("android/app")
                 File.expand_path(store, base)
               end
  UI.user_error!("Keystore referenced by android/key.properties not found: #{store_path}") unless File.file?(store_path)
end

def upload_crashlytics_symbols
  app_id = firebase_android_app_id
  if app_id.empty?
    UI.important("No android.firebase_app_id in #{CONFIG_PATH} — skipping Crashlytics symbol upload")
    return
  end
  unless sh("command -v firebase >/dev/null 2>&1 && echo yes || echo no", log: false).strip == "yes"
    UI.important("Firebase CLI not installed — skipping Crashlytics symbol upload")
    return
  end
  sh("cd #{PROJECT_ROOT.shellescape} && firebase crashlytics:symbols:upload " \
     "--app=#{app_id.shellescape} #{SYMBOLS_DIR}")
end

# --- iOS credentials ----------------------------------------------------------

def asc_key_parts
  load_shared_credentials!

  key_id    = ENV["ASC_KEY_ID"].to_s.strip
  issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
  content   = ENV["ASC_KEY_CONTENT"].to_s.strip
  filepath  = ENV["ASC_KEY_FILEPATH"].to_s.strip

  filepath = resolve_credential_path(filepath).to_s unless filepath.empty?

  # Fall back to the conventional locations for a downloaded .p8.
  if filepath.empty? && content.empty?
    candidates = Dir.glob([
      File.join(SHARED_CREDENTIALS_DIR, "asc", "AuthKey_*.p8"),
      File.join(PROJECT_ROOT, "key", "AuthKey_*.p8"),
      File.expand_path("~/.appstoreconnect/private_keys/AuthKey_*.p8"),
      File.expand_path("~/private_keys/AuthKey_*.p8")
    ])
    candidates.select! { |path| File.basename(path) == "AuthKey_#{key_id}.p8" } unless key_id.empty?
    if candidates.length > 1
      UI.user_error!(
        "Multiple App Store Connect keys were found. Set ASC_KEY_ID and " \
        "ASC_KEY_FILEPATH explicitly in #{File.join(SHARED_CREDENTIALS_DIR, 'credentials.env')}."
      )
    end
    filepath = candidates.first.to_s
  end

  # The key id is embedded in the standard Apple filename.
  key_id = File.basename(filepath, ".p8").sub("AuthKey_", "") if key_id.empty? && !filepath.empty?

  if (filepath.empty? && content.empty?) || key_id.empty? || issuer_id.empty?
    UI.user_error!(<<~MSG)
      App Store Connect API key is not configured.

      This is an ACCOUNT-level credential shared by every app on the team, so it
      belongs in #{SHARED_CREDENTIALS_DIR}, not in an app repo.

      Create one at App Store Connect > Users and Access > Integrations >
      App Store Connect API (role: App Manager), download the .p8 once, then put
      in #{File.join(SHARED_CREDENTIALS_DIR, 'credentials.env')}:
        ASC_KEY_ID=<10-char Key ID>
        ASC_ISSUER_ID=<Issuer ID (UUID) shown above the key list>
        ASC_KEY_FILEPATH=asc/AuthKey_<KEYID>.p8
    MSG
  end

  unless filepath.empty? || File.file?(filepath)
    UI.user_error!("ASC_KEY_FILEPATH points at a file that does not exist: #{filepath}")
  end

  { key_id: key_id, issuer_id: issuer_id, filepath: filepath, content: content }
end

def asc_api_key
  parts = asc_key_parts
  app_store_connect_api_key(
    key_id: parts[:key_id],
    issuer_id: parts[:issuer_id],
    key_filepath: parts[:content].empty? ? parts[:filepath] : nil,
    key_content: parts[:content].empty? ? nil : parts[:content],
    is_key_content_base64: !parts[:content].empty? && !parts[:content].include?("BEGIN PRIVATE KEY"),
    in_house: false
  )
end

def ios_version(options)
  name   = (options[:build_name] || ENV["IOS_BUILD_NAME"] || pubspec_version_parts[0]).to_s.strip
  number = (options[:build_number] || ENV["IOS_BUILD_NUMBER"] || pubspec_version_parts[1]).to_s.strip
  [name, number]
end

# The version actually baked into an .ipa — which is NOT always the one that was
# requested. Xcode has been observed bumping CFBundleVersion during export even
# with manageAppVersionAndBuildNumber=false (asked for build 6, shipped build 7).
# Verifying an upload against the requested number therefore reports a false
# failure, so always confirm against what the artifact really contains.
def ipa_version(ipa_path)
  require "tmpdir"
  Dir.mktmpdir do |dir|
    ok = system("unzip", "-qo", ipa_path, "Payload/*.app/Info.plist", "-d", dir,
                out: File::NULL, err: File::NULL)
    return nil unless ok

    plist = Dir.glob(File.join(dir, "Payload", "*.app", "Info.plist")).first
    return nil if plist.nil?

    short = `/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" #{plist.shellescape}`.strip
    build = `/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" #{plist.shellescape}`.strip
    return nil if short.empty? || build.empty?

    [short, build]
  end
rescue StandardError => e
  UI.verbose("could not read version from #{ipa_path}: #{e.message}")
  nil
end

# Every recent build for THIS app, newest first, including ones still processing.
#
# Deliberately not `latest_testflight_build_number`: it only counts builds that
# have finished processing, and with no `version:` it reports whichever version
# train it considers latest. Straight after an upload that combination reports
# the *previous* build — which reads as "the upload failed" when it did not.
def testflight_builds(api_key, limit: 50)
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(ios_bundle_id)
  UI.user_error!(<<~MSG) if app.nil?
    #{ios_bundle_id} does not exist on App Store Connect for this API key.

    Check `ios.bundle_id` in #{CONFIG_PATH} against the app record in App Store
    Connect — the iOS bundle id often differs from the Android package name.
  MSG
  Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: limit)
end

# Is this exact version/build pair on TestFlight? Sees PROCESSING builds, so it
# resolves within seconds of an upload rather than after processing completes.
def testflight_has_build?(api_key, version, number, attempts: 10, delay: 30)
  attempts.times do |i|
    found = testflight_builds(api_key).any? do |b|
      b.app_version.to_s == version.to_s && b.version.to_s == number.to_s
    end
    return true if found

    if i < attempts - 1
      UI.message("Build #{version} (#{number}) not visible yet; re-checking in #{delay}s")
      sleep(delay)
    end
  end
  false
rescue StandardError => e
  UI.important("Could not query TestFlight: #{e.message}")
  false
end

# Apple's Transporter stalls at random. A given IPA may upload in 100 seconds on
# one attempt and hang for hours on the next, and the same thing happens when
# uploading straight from Xcode — so it is Apple's transport, not this setup.
# Cancelling and retrying reliably clears it, usually within two or three tries.
#
# That makes waiting the wrong strategy: cap each attempt, kill the transfer, and
# start over. A killed multipart upload is discarded server-side, so retrying is
# safe. Between attempts we still ask App Store Connect whether the build landed,
# because a stall can happen *after* the bytes arrived.
def upload_to_testflight_with_retry(api_key:, ipa:, version:, number:, wait:, changelog:)
  attempts  = ios_upload_attempts
  timeout_s = ios_upload_timeout_minutes * 60
  # Kept across attempts so the give-up message can name what actually went
  # wrong. Without it a permanent failure — a revoked key, an invalid binary —
  # was reported as "Apple's transport stalls at random".
  last_error = nil
  # Every transporter/altool already running belongs to another release on this
  # machine, and cancellation must leave those alone. Taken once, before the
  # first attempt: from here on, a process that appears is ours.
  preexisting_uploads = transporter_pids

  attempts.times do |i|
    attempt = i + 1
    UI.message("TestFlight upload attempt #{attempt}/#{attempts} " \
               "(cancelling after #{ios_upload_timeout_minutes} min if it stalls)")

    started = Time.now
    timed_out = false

    # The upload MUST run on the main thread: fastlane's action runner calls
    # Dir.chdir, and Ruby raises "conflicting chdir during another chdir block"
    # if two threads do that at once. So the watchdog is the thread instead — it
    # only sleeps and then kills the transfer, which makes the blocking upload on
    # the main thread fail fast and fall into the retry path below.
    #
    # Held for the whole of a cancellation. Without it the main thread reaches
    # `watchdog.kill` below while kill_transporter! is still inside its
    # five-second SIGTERM grace period — that is the normal ordering, not a rare
    # race, because SIGTERM makes the blocked upload raise within milliseconds —
    # and Thread#kill then tore the watchdog down before the SIGKILL escalation
    # could run. Every `watchdog.kill` therefore takes this lock first.
    cancelling = Mutex.new

    watchdog = Thread.new do
      sleep(timeout_s)
      timed_out = true
      cancelling.synchronize do
        UI.important("Attempt #{attempt} exceeded #{ios_upload_timeout_minutes} min — cancelling the transfer")
        kill_transporter!(preexisting_uploads)
      end
    end

    begin
      upload_to_testflight(
        api_key: api_key,
        app_identifier: ios_bundle_id,
        ipa: ipa,
        skip_submission: true,
        skip_waiting_for_build_processing: !wait,
        changelog: wait ? changelog : nil,
        distribute_external: false
      )
      cancelling.synchronize { watchdog.kill }
      UI.success("Uploaded #{version} (#{number}) to TestFlight in #{(Time.now - started).round}s")
      return
    rescue StandardError => e
      cancelling.synchronize { watchdog.kill }
      last_error = e
      elapsed = (Time.now - started).round

      # A validation rejection is final — App Store Connect refused the binary.
      # Retrying or polling would only waste time. Checked before the watchdog
      # branch, not inside its `else`: Apple's refusal does not become retryable
      # because our own timer happened to expire first, and a cancelled attempt
      # surfaces the rejection text just the same.
      if (rejection = validation_rejection(e.message))
        UI.user_error!(rejection)
      end

      if timed_out
        UI.important("Attempt #{attempt} was cancelled after #{elapsed}s: #{e.message.lines.first.to_s.strip}")
        # The stall may have come after the bytes were already delivered.
        if testflight_has_build?(api_key, version, number, attempts: 2, delay: 20)
          UI.success("#{version} (#{number}) reached TestFlight despite the stall")
          return
        end
      else
        # Transporter retries chunks internally and can deliver the build while
        # still surfacing those retries as a fatal error (classic case:
        # NSURLErrorDomain -1005 "network connection was lost"). Ask App Store
        # Connect what actually happened before calling this attempt a failure.
        # Wait generously here. The two outcomes are not symmetric:
        #   - concluding "failed" too early re-uploads a build that already
        #     landed, which Apple rejects as a duplicate — confusing and slow;
        #   - waiting longer only costs time when the upload really did fail.
        #
        # In an observed upload, altool logged "UPLOAD SUCCEEDED", fastlane raised
        # anyway, and the build took 465 seconds (7m45s) to become visible through
        # the API. A 60-second check missed it and began a needless third attempt.
        # So the window is 10 minutes — comfortably past the worst lag observed,
        # because a false negative is the expensive mistake here.
        UI.important("Attempt #{attempt} failed after #{elapsed}s: #{e.message.lines.first.to_s.strip}")
        UI.message("Transporter often delivers the build despite this error, and " \
                   "App Store Connect can take ~8 minutes to show it — waiting")
        if testflight_has_build?(api_key, version, number, attempts: 20, delay: 30)
          UI.success("#{version} (#{number}) is on TestFlight — the error was transport noise")
          return
        end
      end
    ensure
      cancelling.synchronize { watchdog.kill } if watchdog.alive?
    end

    UI.important("Retrying — Apple's transport stalls at random and usually " \
                 "succeeds on a later attempt") if attempt < attempts
  end

  UI.user_error!(<<~MSG)
    #{version} (#{number}) did not reach TestFlight after #{attempts} attempts,
    each capped at #{ios_upload_timeout_minutes} minutes.

    The last attempt failed with:
      #{last_error&.message.to_s.lines.first.to_s.strip}

    Apple's Transporter stalling is usually transient, so this many failures in a
    row suggests something else. Check your connection, then:
      fastlane ios builds                 # confirm it really is not there
      fastlane ios validate               # run Apple's static validation
      fastlane ios upload_only            # retry without rebuilding

    To let a slow-but-working upload run longer, raise the cap:
      IOS_UPLOAD_TIMEOUT_MINUTES=25 fastlane ios upload_only
  MSG
end

# Cancellation works in PIDs, not in patterns.
#
# The old shape ran `pkill -x altool` and `pkill -f iTMSTransporter` through
# fastlane's `sh`. A pattern kill cannot tell OUR upload from one belonging to
# another release on the same machine, so recovery took out both — a caveat the
# README had to carry. It also went through `sh`, which wraps its argument in
# `/bin/sh -c "<command>"`, giving the wrapper an argv containing the very
# pattern being matched; the only reason that never signalled the shell running
# it is that macOS excludes pgrep/pkill's own ancestors from the match list
# (pkill(1): "the current pgrep or pkill process and all of its ancestors are
# excluded"), which is an accident of the platform rather than a property of
# this code.
#
# So: scan for PIDs before the upload starts, signal only PIDs that were not in
# that scan, and signal from Ruby. Nothing here creates a shell and nothing
# matches a pattern at kill time, so neither problem can return.

# PIDs printed by pgrep. Only bare decimal lines survive: a future flag typo
# makes pgrep print usage text, and a diagnostic must never become a kill target.
def parse_pid_list(text)
  text.to_s.split("\n").map { |line| line.strip[/\A\d+\z/] }.compact.map(&:to_i).uniq
end

# `IO.popen` with an ARGUMENT ARRAY execs pgrep directly — there is no
# `/bin/sh -c` wrapper, so there is no wrapper argv for the pattern to match.
# pgrep exits 1 when nothing matches, which is not an error here.
def pgrep_pids(flag, pattern)
  parse_pid_list(IO.popen(["pgrep", flag, pattern], err: File::NULL, &:read))
rescue StandardError => e
  UI.verbose("pgrep #{flag} #{pattern} failed: #{e.message}")
  []
end

# Anything that could be an upload in flight. The transporter is matched on the
# full command line on purpose: Apple ships a shell wrapper that execs the JVM,
# and a narrower pattern would leave that wrapper holding the network — exactly
# the failure this function exists to prevent.
def transporter_pids
  (pgrep_pids("-f", "iTMSTransporter") + pgrep_pids("-x", "altool")).uniq
end

def process_command_line(pid)
  IO.popen(["ps", "-o", "command=", "-p", pid.to_s], err: File::NULL, &:read).to_s.strip
rescue StandardError
  ""
end

# The single call that actually signals, split out so it can be observed in a
# test without signalling anything real.
def kill_process(signal, pid)
  Process.kill(signal, pid)
end

# The PIDs that actually received the signal. One that exited between the scan
# and the signal is the outcome we wanted, not a failure.
def signal_pids!(signal, pids)
  pids.select do |pid|
    begin
      kill_process(signal, pid)
      true
    rescue Errno::ESRCH
      false
    rescue StandardError => e
      UI.important("Could not send SIG#{signal} to pid #{pid}: #{e.message}")
      false
    end
  end
end

# Stop an in-flight upload. altool drives a Java iTMSTransporter child, and
# killing the Ruby thread alone would leave it running and holding the network.
#
# `preexisting` is the PID scan taken before this upload started; those processes
# belong to somebody else and are never signalled.
def kill_transporter!(preexisting = [])
  targets = transporter_pids - Array(preexisting)
  if targets.empty?
    UI.important("No upload process of this run is left to cancel")
    return
  end

  targets.each do |pid|
    UI.important("Cancelling upload process #{pid}: #{process_command_line(pid)}")
  end

  signalled = signal_pids!("TERM", targets)
  return if signalled.empty?

  sleep(5)
  # Re-scan rather than probe with signal 0: a PID that has been reused since the
  # SIGTERM is only a target again if it is still a transporter or an altool.
  still = signalled & transporter_pids
  return if still.empty?

  still.each { |pid| UI.important("pid #{pid} did not exit after SIGTERM; sending SIGKILL") }
  signal_pids!("KILL", still)
end

# Apple closes a "pre-release train" once a version has been through review, and
# refuses further TestFlight builds for it with a 409. That is not something the
# build-number check can see: a version can have a single TestFlight build and
# still be closed. Recognising the rejection text is what turns a five-minute
# confusing failure into a one-line instruction.
def validation_rejection(message)
  text = message.to_s

  if text.include?("Invalid Pre-Release Train") || text.include?("closed for new build submissions")
    version = text[/train version '([^']+)'/, 1] || "this version"
    return <<~MSG
      App Store Connect rejected the build: the version train #{version} is CLOSED.

      Apple closes a version train once it has been through review, and then
      refuses any further TestFlight build for it — regardless of build number.
      A higher build number will NOT help.

      Raise the marketing version instead:
        fastlane ios release build_name:<higher than #{version}> build_number:1

      See which versions exist: `fastlane ios builds`.
    MSG
  end

  if text.include?("must contain a higher version than that of the previously approved version")
    approved = text[/previously approved version \[([^\]]+)\]/, 1] || "the released version"
    return <<~MSG
      App Store Connect rejected the build: CFBundleShortVersionString must be
      higher than the already-approved version #{approved}.

      Raise the marketing version:
        fastlane ios release build_name:<higher than #{approved}> build_number:1
    MSG
  end

  nil
end

# Marketing versions that already reached the App Store. Building one of these
# again is rejected, so it is worth knowing before an archive.
#
# Best-effort: any store failure answers [] and a verbose log line, because the
# release-path callers use this as an extra guard and must not fail a release
# over one flaky read. THAT MAKES [] AMBIGUOUS — it means "the App Store lists
# nothing" and "the App Store did not answer" alike. Anything that reports to a
# human has to tell those apart, and must call `appstore_released_versions!` and
# handle the exception instead.
def appstore_released_versions(api_key)
  appstore_released_versions!(api_key)
rescue FastlaneCore::Interface::FastlaneError
  # `ios_bundle_id` raises this for a missing `ios.bundle_id`. Swallowing it
  # returned [] and silently skipped the released-version guard in
  # `warn_if_testflight_build_taken`.
  raise
rescue StandardError => e
  UI.verbose("could not read App Store versions: #{e.message}")
  []
end

# The same read with every failure left to the caller.
def appstore_released_versions!(api_key)
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)
  app = Spaceship::ConnectAPI::App.find(ios_bundle_id)
  # Not []: an app this key cannot see is not an app that has never shipped, and
  # a caller that reports the second sentence to a user sends them off to reuse
  # a version number the App Store already holds. A plain error, not a fastlane
  # user error, so the best-effort wrapper above still absorbs it.
  raise "App Store Connect has no app with this bundle id, or this key cannot see it" if app.nil?

  terminal = %w[READY_FOR_SALE APPROVED PENDING_DEVELOPER_RELEASE REPLACED_WITH_NEW_INFO]
  app.get_app_store_versions(limit: 50)
     .select { |v| terminal.include?(v.app_store_state.to_s) }
     .map { |v| v.version_string.to_s }
end

def warn_if_testflight_build_taken(options, api_key)
  name, number = ios_version(options)
  return unless number.match?(/\A\d+\z/)

  if appstore_released_versions(api_key).include?(name)
    UI.user_error!(<<~MSG)
      Version #{name} is already released on the App Store, so its version train
      is closed and TestFlight will reject any build for it.

      Raise the marketing version:
        fastlane ios release build_name:<higher than #{name}> build_number:1
    MSG
  end

  begin
    same_version = testflight_builds(api_key).select { |b| b.app_version.to_s == name }
  rescue FastlaneCore::Interface::FastlaneError
    raise
  rescue StandardError => e
    UI.important("Could not read TestFlight builds — skipping that check (#{e.message})")
    return
  end

  return if same_version.empty?

  latest = same_version.map { |b| b.version.to_i }.max
  return if number.to_i > latest

  UI.user_error!(<<~MSG)
    TestFlight already has build #{latest} for version #{name}, so build
    #{number} will be rejected.

    Pass the next one explicitly, e.g.
      fastlane ios release build_name:#{name} build_number:#{latest + 1}
    or bump the version in pubspec.yaml / set IOS_BUILD_NUMBER in fastlane/.env.
  MSG
end

# `flutter build ipa` signs with Xcode's automatic signing. That needs a
# distribution identity in the login keychain; without one the archive fails
# deep inside xcodebuild with an unhelpful error, so check up front.
def preflight_ios_signing
  identities = sh("security find-identity -v -p codesigning || true", log: false)
  unless identities.match?(/Apple Distribution|iPhone Distribution/)
    UI.user_error!(<<~MSG)
      No Apple Distribution signing identity in the login keychain
      (found only: #{identities.scan(/"([^"]+)"/).flatten.join(', ')}).

      The certificate is account-level, so creating it once covers every app on
      team #{ios_team_id}:
        fastlane ios setup_signing

      Alternatively import an existing distribution .p12 into the login keychain,
      or add the account in Xcode > Settings > Accounts > Manage Certificates.
    MSG
  end

  return if File.file?(ios_profile_path)

  UI.user_error!(<<~MSG)
    The Release Kit provisioning profile for #{ios_bundle_id} is missing:
      #{ios_profile_path}

    Create or refresh the app-specific profile before building:
      fastlane ios setup_signing
  MSG
end

# `flutter build ipa` needs an ExportOptions.plist. It is derived entirely from
# release_kit.yml, so generate it rather than making every repo hand-maintain a
# copy — and keep the two settings that matter correct:
#   destination = export  (otherwise xcodebuild uploads during export and
#                          leaves no .ipa for upload_to_testflight)
#   manageAppVersionAndBuildNumber = false (keep Flutter's version numbers)
def ensure_export_options!
  path = abs(EXPORT_OPTIONS)
  return if File.file?(path)

  UI.important("#{EXPORT_OPTIONS} missing — generating it for team #{ios_team_id}")
  File.write(path, export_options_plist(ios_team_id, ios_bundle_id))
end

def export_options_plist(team_id, bundle_id)
  <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
        <key>method</key>
        <string>app-store-connect</string>
        <key>teamID</key>
        <string>#{team_id}</string>
        <!-- `ios setup_signing` creates this deterministic profile name.
             Pinning it prevents Xcode from silently selecting a stale
             automatic profile for another distribution certificate. -->
        <key>signingStyle</key>
        <string>manual</string>
        <key>signingCertificate</key>
        <string>Apple Distribution</string>
        <key>provisioningProfiles</key>
        <dict>
            <key>#{bundle_id}</key>
            <string>#{bundle_id} AppStore</string>
        </dict>
        <key>uploadSymbols</key>
        <true/>
        <!-- `export` writes a local .ipa that Fastlane then uploads. Do NOT set
             this to `upload`: xcodebuild would push the build itself during
             export, leaving no .ipa on disk for upload_to_testflight. -->
        <key>destination</key>
        <string>export</string>
        <!-- Keep the version/build numbers Flutter baked in. -->
        <key>manageAppVersionAndBuildNumber</key>
        <false/>
    </dict>
    </plist>
  PLIST
end

# =============================================================================
# Store version report (READ ONLY)
# =============================================================================
#
# One version-name field and one build-number field in pubspec.yaml cannot
# describe two stores: Play and App Store Connect count uploads independently,
# so their build numbers drift apart and the duplicate is discovered when the
# upload is rejected. `fastlane store_versions` answers, before anything is
# built, what each store already holds.
#
# It reports FACTS ONLY. There is deliberately no "next" or "suggested" number
# anywhere in the payload: version numbers are never auto-incremented by this
# kit, and a suggestion the user has to accept belongs in the client, not here.
#
# Read-only in the strict sense: nothing is built, nothing is uploaded, nothing
# is promoted, nothing is written into the project. The one write-shaped call is
# Play's `insert_edit`, which opens a scratch transaction that is thrown away
# again in the same breath (`play_status`); it is the only way the Publishing
# API lets anyone read a track, and it is the same probe `check_credentials`
# has always used.
#
# --- output contract ---------------------------------------------------------
#
# Exactly one line on stdout:
#
#   <<<FRK:STORE_VERSIONS:1>>> {"project":…,"checkedAt":…,"android":{…},"ios":{…}}
#
# fastlane writes a great deal to stdout — banners, tables, ANSI colour, plugin
# chatter — and it does not always end that output with a newline, so a "last
# line" or "line that starts with {" parse is not safe. The marker is the
# contract: scan every line for STORE_VERSIONS_MARKER as a SUBSTRING, take
# everything after it on that line as the JSON document, and if more than one
# line carries the marker use the LAST one. The trailing `:1` is the payload
# version and changes only if the shape changes incompatibly.
#
# `protocolVersion` and `cliVersion` are NOT emitted here: this file has no idea
# which CLI invoked it. The CLI wraps this document with those two fields.
#
# --- never raises ------------------------------------------------------------
#
# The desktop app calls this speculatively behind a spinner and kills the
# process to cancel, so a crash report is a worse answer than "could not check".
# Every path returns a platform object carrying `status` and `detail`, including
# the paths where release_kit.yml itself is unreadable.
#
# The guarantee covers the whole way to stdout, not just building the report:
# serialising it and logging it are inside it too (`emit_store_versions_report`).
#
# --- never guesses -----------------------------------------------------------
#
# A store that could not be read is never reported as a store that holds
# nothing. The two halves of each platform fail independently and are reported
# independently, because a confident wrong answer ("nothing has been released")
# costs the user a rejected upload, while an honest "could not read" costs them
# a retry.
#
# --- never leaks -------------------------------------------------------------
#
# No key path, key id, issuer id, service-account email or token reaches the
# payload. Sentences written here are written by hand; any text that came from
# outside (a store error, an exception message) goes through
# `store_versions_safe_message` first.

STORE_VERSIONS_MARKER = "<<<FRK:STORE_VERSIONS:1>>>".freeze

# Seconds one platform's probe may run before it is reported as unavailable.
# Both platforms get their own budget, so the worst case is twice this.
STORE_VERSIONS_TIMEOUT_SECONDS = 60

# How many TestFlight builds to include. Apple scopes build numbers to the
# version string, so a single "latest build" is meaningless — the client needs
# enough of the list to find the train it cares about.
STORE_VERSIONS_BUILD_LIMIT = 10

# Applied to text this file did not write. Ordered widest-context first so a
# private key or a path is gone before the narrower rules chew on its pieces.
STORE_VERSIONS_REDACTIONS = [
  /-----BEGIN[\s\S]*/,                                                    # PEM private key material
  /[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}/,                     # service-account and Apple ID emails
  /\b[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\b/,             # issuer ids (UUIDs)
  %r{(?:~|/)[\w.\-+]+(?:/[\w.\-+]*)+},                                    # absolute and home-relative paths
  /\b[0-9A-Z]{10}\b/,                                                     # App Store Connect key ids and team ids
  %r{\b[A-Za-z0-9+/=_\-]{24,}\b}                                          # bearer tokens, base64 blobs
].freeze

# The report of last resort: emitted only when building the real one threw AND
# building the fallback threw too, or when JSON refused to serialise what was
# built. Written out in full, in plain ASCII, so that nothing between here and
# stdout can fail the way the thing it replaces did. `checkedAt` is empty on
# purpose — the CLI substitutes its own moment for a timestamp it cannot parse,
# and a made-up one here would be worse than none.
STORE_VERSIONS_UNREPORTABLE_DETAIL =
  "This project's store report could not be produced, so this store was not read.".freeze
STORE_VERSIONS_UNREPORTABLE = {
  "project" => "",
  "checkedAt" => "",
  "android" => {
    "status" => "unavailable",
    "detail" => STORE_VERSIONS_UNREPORTABLE_DETAIL,
    "track" => nil,
    "latestVersionCode" => nil,
    "latestVersionName" => nil,
    "tracks" => []
  },
  "ios" => {
    "status" => "unavailable",
    "detail" => STORE_VERSIONS_UNREPORTABLE_DETAIL,
    "latestAppStoreVersion" => nil,
    "builds" => []
  }
}.freeze

# Entry point for the lane. The marker line reaches stdout whatever happens,
# because a client waiting on that line would otherwise hang until its own
# timeout with nothing to show the user.
#
# EVERYTHING on the way to that line is inside the guarantee, not just the
# report-building call: the two log lines below read into the report, and
# JSON.generate can refuse a string a store handed us. Both used to sit outside
# the rescue, so either could still take the whole lane down.
def emit_store_versions_report(options = {})
  report = store_versions_reported(options)
  line = store_versions_marker_line(report)

  begin
    UI.message("Android: #{report['android']['detail']}")
    UI.message("iOS: #{report['ios']['detail']}")
  rescue StandardError
    # The log lines are a courtesy for whoever is watching the run. The marker
    # line is the contract, and it goes out either way.
    nil
  end

  $stdout.puts(line)
  $stdout.flush
  report
end

# The report, or a stand-in written in this file — never an exception.
def store_versions_reported(options)
  store_versions_report(options)
rescue StandardError => e
  begin
    store_versions_fallback_report(e)
  rescue StandardError
    STORE_VERSIONS_UNREPORTABLE
  end
end

# The one line the client parses, or the stand-in's line if this report cannot
# be serialised — invalid UTF-8 out of a store error is the realistic way in.
def store_versions_marker_line(report)
  "#{STORE_VERSIONS_MARKER} #{JSON.generate(report)}"
rescue StandardError
  "#{STORE_VERSIONS_MARKER} #{JSON.generate(STORE_VERSIONS_UNREPORTABLE)}"
end

def store_versions_report(options = {})
  seconds = store_versions_timeout(options)
  {
    "project" => store_versions_project_name,
    # UTC with milliseconds, so two checks a second apart are distinguishable.
    "checkedAt" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%S.%LZ"),
    "android" => store_versions_android(seconds),
    "ios" => store_versions_ios(seconds)
  }
end

def store_versions_fallback_report(error)
  detail = "This project's release setup could not be read: #{store_versions_safe_message(error.message)}"
  {
    "project" => File.basename(PROJECT_ROOT),
    "checkedAt" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%S.%LZ"),
    "android" => store_versions_android_state("unconfigured", detail),
    "ios" => store_versions_ios_state("unconfigured", detail)
  }
end

def store_versions_project_name
  config["name"].to_s
rescue StandardError
  File.basename(PROJECT_ROOT)
end

def store_versions_timeout(options)
  raw = (options || {})[:timeout] || ENV["FRK_STORE_VERSIONS_TIMEOUT"] || STORE_VERSIONS_TIMEOUT_SECONDS
  seconds = raw.to_i
  seconds.positive? ? seconds : STORE_VERSIONS_TIMEOUT_SECONDS
end

# Every key is always present, with null or [] for "not known", so a client can
# read one shape regardless of status instead of branching on key existence.
def store_versions_android_state(status, detail, track: nil, latest_code: nil, latest_name: nil, tracks: [])
  {
    "status" => status,
    "detail" => store_versions_sentence(detail),
    "track" => track,
    "latestVersionCode" => latest_code,
    "latestVersionName" => latest_name,
    "tracks" => tracks
  }
end

def store_versions_ios_state(status, detail, latest_release: nil, builds: [])
  {
    "status" => status,
    "detail" => store_versions_sentence(detail),
    "latestAppStoreVersion" => latest_release,
    "builds" => builds
  }
end

def store_versions_sentence(text)
  one_line = text.to_s.gsub(/\s+/, " ").strip
  one_line.length > 400 ? "#{one_line[0, 397]}..." : one_line
end

# For text that came from a store, a gem or an exception. First line only (the
# rest is invariably a backtrace or a setup essay), then every credential shape
# this kit handles is replaced before the words are allowed near the payload.
def store_versions_safe_message(text)
  cleaned = text.to_s.lines.first.to_s
  STORE_VERSIONS_REDACTIONS.each { |pattern| cleaned = cleaned.gsub(pattern, "<redacted>") }
  store_versions_sentence(cleaned)
end

# `platforms` raises on an unreadable release_kit.yml. That is still "this
# project is not set up for android", so it answers false rather than escaping.
def store_versions_configured?(platform)
  platforms.include?(platform.to_s)
rescue StandardError
  false
end

def store_versions_unconfigured_detail(platform)
  "This project does not list #{platform} in `platforms` in #{CONFIG_PATH} (it lists: #{platforms.join(', ')})."
rescue StandardError => e
  "#{CONFIG_PATH} could not be read, so #{platform} is not configured: #{store_versions_safe_message(e.message)}"
end

# --- Android ------------------------------------------------------------------

def store_versions_android(seconds)
  unless store_versions_configured?(:android)
    return store_versions_android_state("unconfigured", store_versions_unconfigured_detail("android"))
  end

  begin
    android_package
    track = android_track
  rescue StandardError => e
    return store_versions_android_state(
      "unconfigured",
      "This project's android section in #{CONFIG_PATH} is not usable: #{store_versions_safe_message(e.message)}"
    )
  end

  begin
    json_key = play_store_json_key
  rescue StandardError
    # The message from `play_store_json_key` names key paths, so it is dropped
    # entirely rather than redacted; `check_credentials` prints it in full.
    return store_versions_android_state(
      "no_credentials",
      "No Google Play service-account key is available, so Play was not contacted; " \
      "run `fastlane android check_credentials` for the setup steps.",
      track: track
    )
  end

  begin
    status = Timeout.timeout(seconds) { play_status(json_key, include_tracks: true) }
  rescue Timeout::Error
    return store_versions_android_state(
      "unavailable", "Google Play did not answer within #{seconds} seconds.", track: track
    )
  rescue StandardError => e
    return store_versions_android_state(
      "unavailable", "Could not read Google Play: #{store_versions_safe_message(e.message)}", track: track
    )
  end

  unless status[:ok]
    return store_versions_android_state("unavailable", store_versions_play_failure_detail(status), track: track)
  end

  listed = Array(status[:tracks])
  configured = store_versions_configured_track(track, listed, status)
  listed += [configured] if configured && listed.none? { |t| t["track"] == track }
  tracks = store_versions_order_tracks(listed, track)
  latest_code = store_versions_highest_code(status, tracks)
  # Pair the name with the code it actually belongs to. Naming the configured
  # track's version beside another track's higher code would be a lie.
  owner = tracks.find { |t| t["versionCode"] == latest_code }

  store_versions_android_state(
    "ok",
    store_versions_play_detail(latest_code, track, configured),
    track: track,
    latest_code: latest_code,
    latest_name: owner && owner["versionName"],
    tracks: tracks
  )
end

# What is known about the configured track, as a track entry or nil.
#
# `status[:tracks]` is the all-tracks listing, which is best-effort and comes
# back empty when it fails. The configured track is not part of that gamble:
# `play_status` reads it directly with get_edit_track, and `status[:ok]` is only
# true if that read succeeded, so `internal_codes` is the answer whatever the
# listing did. Deriving the configured track from the listing instead turned a
# failed listing into "the configured track holds no release" — an assertion
# about a track nothing had read, and the one sentence that makes a user pick a
# version code Play will reject.
#
# The listing is still preferred when it has the track, because only it carries
# a version name.
def store_versions_configured_track(track, listed, status)
  from_listing = listed.find { |t| t["track"] == track }
  return from_listing if from_listing

  codes = Array(status[:internal_codes]).map(&:to_i).reject { |c| c <= 0 }
  return nil if codes.empty?

  { "track" => track, "versionCode" => codes.max, "versionName" => nil }
end

# Play rejects a version code that is already used ANYWHERE in the app, not just
# on the target track, so the number that matters is the highest one Play has
# ever seen: uploaded bundles included, since a bundle can exist with no release.
def store_versions_highest_code(status, tracks)
  codes = Array(status[:uploaded_codes]) + Array(status[:internal_codes]) + tracks.map { |t| t["versionCode"] }
  codes = codes.map(&:to_i).reject { |c| c <= 0 }
  codes.empty? ? nil : codes.max
end

# Configured track first — it is the one the user is about to upload to — then
# the rest in a stable order so the client's list does not reshuffle per call.
def store_versions_order_tracks(tracks, configured)
  mine, others = tracks.partition { |t| t["track"] == configured }
  mine + others.sort_by { |t| t["track"].to_s }
end

def store_versions_play_detail(latest_code, track, configured)
  return "Google Play holds no version code for this app yet, so any version code is free." if latest_code.nil?

  # "holds no release" is only sayable because get_edit_track answered for this
  # exact track — see `store_versions_configured_track`. Never say it from a
  # listing that failed to load.
  where = if configured
            "the configured '#{track}' track is at #{configured['versionCode']}"
          else
            "the configured '#{track}' track holds no release"
          end
  "Google Play's highest known version code is #{latest_code} and #{where}."
end

def store_versions_play_failure_detail(status)
  if status[:denied]
    "Google Play denied this service account access to the app; " \
      "run `fastlane android check_credentials` for the exact permission to grant."
  elsif status[:missing]
    "Google Play has no app with this package name, or the service account cannot see it; " \
      "run `fastlane android check_credentials` for next steps."
  else
    "Could not read Google Play: #{store_versions_safe_message(status[:message])}"
  end
end

# --- iOS ----------------------------------------------------------------------

def store_versions_ios(seconds)
  unless store_versions_configured?(:ios)
    return store_versions_ios_state("unconfigured", store_versions_unconfigured_detail("ios"))
  end

  begin
    ios_bundle_id
  rescue StandardError => e
    return store_versions_ios_state(
      "unconfigured",
      "This project's ios section in #{CONFIG_PATH} is not usable: #{store_versions_safe_message(e.message)}"
    )
  end

  begin
    api_key = asc_api_key
  rescue StandardError
    # Dropped rather than redacted, same reasoning as the Play key: the message
    # names the .p8 path and the environment variables that hold the key id.
    return store_versions_ios_state(
      "no_credentials",
      "No App Store Connect API key is available, so App Store Connect was not contacted; " \
      "run `fastlane ios check_credentials` for the setup steps."
    )
  end

  # Two independent reads under one deadline. They are kept apart because they
  # fail apart: App Store Connect can serve the TestFlight build list and refuse
  # the App Store version list in the same breath, and folding that into one
  # answer is how "the release list is unreadable" became "nothing has been
  # released on the App Store yet".
  builds = released = nil
  builds_error = released_error = nil
  timed_out = false
  begin
    Timeout.timeout(seconds) do
      # `testflight_builds` rather than `latest_testflight_build_number`: the
      # latter only counts builds that finished PROCESSING, so for the first
      # ~15 minutes after an upload it reports the PREVIOUS build and the app
      # would tell the user their upload never arrived.
      builds, builds_error = store_versions_read { testflight_builds(api_key, limit: STORE_VERSIONS_BUILD_LIMIT) }
      released, released_error = store_versions_read { appstore_released_versions!(api_key) }
    end
  rescue Timeout::Error
    timed_out = true
  end

  # The deadline almost always lands on the first read, and "App Store Connect
  # did not answer" is a better sentence than two half-sentences saying it twice.
  if timed_out && builds.nil? && released.nil? && builds_error.nil? && released_error.nil?
    return store_versions_ios_state("unavailable", "App Store Connect did not answer within #{seconds} seconds.")
  end

  builds_problem = store_versions_problem(builds, builds_error, timed_out, seconds)
  released_problem = store_versions_problem(released, released_error, timed_out, seconds)
  entries = Array(builds).map { |build| store_versions_build_entry(build) }
  latest_release = released.nil? ? nil : store_versions_highest_version(released)

  store_versions_ios_state(
    builds_problem || released_problem ? "unavailable" : "ok",
    store_versions_ios_detail(entries, latest_release, builds_problem, released_problem),
    latest_release: latest_release,
    builds: entries
  )
end

# One store read, as [value, nil] or [nil, error]. Never as an empty answer: an
# empty list is a fact about the store and a failure is not, and this whole
# report exists to keep those two apart.
#
# Timeout::Error is re-raised rather than captured, because the deadline belongs
# to the section, not to one read — swallowing it here would start the next read
# with the budget already spent.
def store_versions_read
  [yield, nil]
rescue Timeout::Error
  raise
rescue StandardError => e
  [nil, e]
end

# Why one half of the iOS report has no answer, as a redacted fragment, or nil
# when it does have one.
def store_versions_problem(value, error, timed_out, seconds)
  return nil unless value.nil?
  return store_versions_safe_message(error.message) if error

  timed_out ? "no answer within #{seconds} seconds" : "the read did not complete"
end

def store_versions_build_entry(build)
  {
    "version" => store_versions_value(build.app_version),
    "build" => store_versions_build_number(build.version),
    "state" => store_versions_value(build.processing_state)
  }
end

def store_versions_value(value)
  text = value.to_s.strip
  text.empty? ? nil : text
end

# CFBundleVersion is a string and Apple accepts dotted forms such as "1.2.3".
# The contract wants a number or null, and inventing 1 out of "1.2.3" would be a
# fabricated build number in a report whose whole purpose is avoiding a wrong
# one — so anything that is not a plain integer is reported as null.
def store_versions_build_number(value)
  text = value.to_s.strip
  text.match?(/\A\d+\z/) ? text.to_i : nil
end

def store_versions_highest_version(versions)
  cleaned = Array(versions).map { |v| v.to_s.strip }.reject(&:empty?)
  return nil if cleaned.empty?

  # Segment-wise, so 2.0.10 beats 2.0.9 — a plain string sort gets that backwards.
  cleaned.max_by { |v| (v.split(".").map(&:to_i) + [0, 0, 0, 0]).first(4) }
end

# One sentence with one clause per half, so a partial answer says which half is
# missing instead of presenting the half it has as the whole truth.
def store_versions_ios_detail(entries, latest_release, builds_problem = nil, released_problem = nil)
  testflight =
    if builds_problem
      "Could not read App Store Connect's TestFlight builds (#{builds_problem})"
    elsif entries.empty?
      "TestFlight has no builds for this app yet"
    else
      newest = entries.first
      version = newest["version"] || "an unnamed version"
      state = newest["state"] || "unknown"
      if newest["build"]
        "TestFlight's newest upload is build #{newest['build']} of version #{version}, state #{state}"
      else
        "TestFlight's newest upload is a build of version #{version} whose build number is not a " \
          "plain integer, state #{state}"
      end
    end

  released =
    if released_problem
      # NEVER "nothing has been released" here. A read that failed says nothing
      # about the App Store, and a user who believes it picks a version number
      # that collides with one Apple already has.
      "the App Store release list could not be read (#{released_problem})"
    elsif latest_release
      "the latest App Store release is #{latest_release}"
    else
      "nothing has been released on the App Store yet"
    end

  "#{testflight}; #{released}."
end
